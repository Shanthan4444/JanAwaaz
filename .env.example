PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/jansetu
JWT_SECRET=your_jwt_secret_key_here

GEMINI_API_KEY=your_gemini_api_key_here
FEATHERLESS_API_KEY=
