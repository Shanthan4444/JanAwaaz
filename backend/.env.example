# ==============================================================================
# JANSETU BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Template for environment configuration - NO real secrets or credentials
# ==============================================================================

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=

# Authentication
JWT_SECRET=

# Gemini AI Engine
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEYS=

# Featherless AI Engine
FEATHERLESS_API_KEY=
FEATHERLESS_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
FEATHERLESS_API_URL=https://api.featherless.ai/v1/chat/completions

# Groq AI Engine (Fallback)
GROQ_API_KEY=

# Civic AI / Duplicate Detection
DUPLICATE_SEARCH_RADIUS_METERS=300
CIVIC_ISSUE_THRESHOLD=0.50
ASSIGNMENT_TIMEOUT_HOURS=24

# Twilio SMS Verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
